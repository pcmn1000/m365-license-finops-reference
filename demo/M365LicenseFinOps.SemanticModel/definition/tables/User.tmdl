/// Current Microsoft 365 user attributes used to analyze license utilization by organization.
table User

	/// Stable Microsoft Entra user identifier.
	column 'User ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: user_id

	/// Sign-in name used by Microsoft 365 services.
	column 'User Principal Name'
		dataType: string
		summarizeBy: none
		sourceColumn: user_principal_name

	/// User name shown in reports.
	column 'Display Name'
		dataType: string
		summarizeBy: none
		sourceColumn: display_name

	/// Department recorded in Microsoft Entra ID; missing values are grouped as Unassigned.
	column Department
		dataType: string
		summarizeBy: none
		sourceColumn: department

	/// Job title recorded in Microsoft Entra ID.
	column 'Job Title'
		dataType: string
		summarizeBy: none
		sourceColumn: job_title

	/// Company recorded in Microsoft Entra ID.
	column Company
		dataType: string
		summarizeBy: none
		sourceColumn: company_name

	/// Office location recorded in Microsoft Entra ID.
	column 'Office Location'
		dataType: string
		summarizeBy: none
		sourceColumn: office_location

	/// Country associated with the user's current organization and office assignment.
	column Country
		dataType: string
		dataCategory: Country
		summarizeBy: none
		sourceColumn: country

	/// City used for geographic license cost and utilization analysis.
	column City
		dataType: string
		dataCategory: City
		summarizeBy: none
		sourceColumn: city

	/// Stable HR employee identifier retained for governed joins but hidden from report authors.
	column 'Employee ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: employee_id

	/// Business division supplied through Microsoft Entra employee organization data.
	column Division
		dataType: string
		summarizeBy: none
		sourceColumn: division

	/// Finance cost center supplied through Microsoft Entra employee organization data.
	column 'Cost Center'
		dataType: string
		summarizeBy: none
		sourceColumn: cost_center

	/// Whether the Microsoft Entra account can sign in.
	column 'Account Enabled'
		dataType: boolean
		summarizeBy: none
		sourceColumn: account_enabled

	/// Microsoft Entra member or guest classification.
	column 'User Type'
		dataType: string
		summarizeBy: none
		sourceColumn: user_type

	column 'Snapshot Date'
		dataType: dateTime
		isHidden
		isAvailableInMdx: false
		formatString: yyyy-MM-dd
		summarizeBy: none
		sourceColumn: snapshot_date

	partition User = entity
		mode: directLake
		source
			entityName: dim_user
			expressionSource: 'DirectLake - M365LicenseFinOps'
